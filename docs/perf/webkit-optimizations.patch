 // window, heavily blurred and darkened, with its palette as soft light.
 // Settings > Appearance > "Artwork colour in background" scales it.
 import { AnimatePresence, motion } from "motion/react";
-import { useState } from "react";
+import { useEffect, useRef, useState } from "react";
 import { imageUrl } from "@/ipc/images";
 import { useAmbient } from "@/lib/ambient";
 import { ambientFade } from "@/lib/motion";
 
+// The softness is made once, on a thumbnail, instead of by a 72 px CSS blur
+// over a window-sized picture (which the GPU redoes on every composited frame,
+// the costliest thing on screen on a laptop with shared memory). The picture
+// is drawn at 16x9, then scaled back up in steps: each bilinear step spreads
+// the colour, and the stretch to the window finishes the job. Colour grading
+// stays a cheap CSS filter.
+const BASE_W = 16;
+const BASE_H = 9;
+const OUT_W = 128;
+const OUT_H = 72;
+
+function soften(img: HTMLImageElement, canvas: HTMLCanvasElement) {
+  const ctx = canvas.getContext("2d");
+  if (!ctx || !img.naturalWidth) return false;
+  // Crop the picture to the canvas' aspect ratio, as object-fit: cover would.
+  const want = OUT_W / OUT_H;
+  let sw = img.naturalWidth;
+  let sh = img.naturalHeight;
+  if (sw / sh > want) sw = sh * want;
+  else sh = sw / want;
+  const sx = (img.naturalWidth - sw) / 2;
+  const sy = (img.naturalHeight - sh) / 2;
+  const step = (w: number, h: number) => {
+    const c = document.createElement("canvas");
+    c.width = w;
+    c.height = h;
+    const g = c.getContext("2d")!;
+    g.imageSmoothingQuality = "high";
+    return [c, g] as const;
+  };
+  const [small, sg] = step(BASE_W, BASE_H);
+  sg.drawImage(img, sx, sy, sw, sh, 0, 0, BASE_W, BASE_H);
+  let from: HTMLCanvasElement = small;
+  for (let w = BASE_W * 2; w <= OUT_W; w *= 2) {
+    const [c, g] = step(w, (w * OUT_H) / OUT_W);
+    g.drawImage(from, 0, 0, c.width, c.height);
+    from = c;
+  }
+  ctx.imageSmoothingQuality = "high";
+  ctx.drawImage(from, 0, 0, OUT_W, OUT_H);
+  return true;
+}
