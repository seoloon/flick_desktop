{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flick",
  "identifier": "flick.seoloon.work",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter oneshot-ui dev",
    "beforeBuildCommand": "pnpm --filter oneshot-ui build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Flick",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob: oneshot-img: http://oneshot-img.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2Qjc5QkQzOTVFQTVCQ0MKUldUTVcrcVYwNXUzeG4xQnc4ZGRFSmFKeHBNNThMNmxJVGJrckZsdUk2S01KSmxRaExPL2pYUkMK",
      "endpoints": [
        "https://github.com/seoloon/flick_desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
